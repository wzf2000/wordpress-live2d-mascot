msgid "The inventory report could not be encoded. No report was saved."
msgstr "无法编码盘点报告，未保存报告。"

msgid "The lightweight entry check passed."
msgstr "轻量入口检查通过。"

msgid "The model contains unsupported reference types."
msgstr "存在不支持的模型引用类型。"

msgid "The model requires at least one valid motion for idle playback."
msgstr "模型至少需要一个合法动作，供待机使用。"

msgid "The motion catalog contains duplicate IDs or invalid file references."
msgstr "动作目录包含重复 ID 或无效文件引用。"

msgid "The new model cannot preserve %s motions by file path. Configuration is unchanged. Review and select “Allow incompatible motion reset” before uploading again."
msgstr "新模型无法按文件路径保留现有 %s 动作。配置未改变；确认后勾选“允许重置不兼容动作”再上传。"

msgid "The path display is truncated; metadata counts cover the bounded scan."
msgstr "路径列表已截断；元数据统计覆盖本次有界扫描。"

msgid "The plugin includes no Core or models. Obtain resources you have the right to use on this site and read their source licenses and terms. Successful import does not grant redistribution rights."
msgstr "插件不附带 Core 或模型。请自行取得有权在本站使用的资源，阅读来源许可与使用条件；导入成功不代表取得再分发许可。"

msgid "The rendering program is invalid; this character cannot be displayed."
msgstr "绘图程序无效，无法显示此角色"

msgid "The required Core file and SHA256 are valid."
msgstr "固定 Core 文件和 SHA256 正常。"

msgid "The resource operation failed. Check the installed resources and server permissions, then retry. Existing configuration is retained."
msgstr "资源操作失败。请检查已安装资源和服务器权限后重试。现有配置已保留。"

msgid "The resource root exists but is not a directory."
msgstr "资源根路径已存在，但不是目录。"

msgid "The resource root is unavailable or unsafe."
msgstr "资源根目录不可用或不安全。"

msgid "The runtime component is invalid. Try again."
msgstr "运行组件无效，请重试"

msgid "The runtime component is missing. Try again later."
msgstr "运行组件不存在，请稍后重试"

msgid "The server could not accept the upload. Ask an administrator to check temporary upload storage and write permissions, then retry."
msgstr "服务器无法接收上传。请让管理员检查临时上传目录的存储空间与写入权限，然后重试。"

msgid "The server requires PHP ZipArchive."
msgstr "服务器需要 PHP ZipArchive。"

msgid "The task guard changed. Ask an administrator to inspect resource storage before recovery."
msgstr "任务守卫已变更。恢复前请管理员检查资源存储。"

msgid "The task guard is unavailable or unsafe. Ask an administrator to inspect resource storage."
msgstr "任务守卫不可用或不安全。请管理员检查资源存储。"

msgid "The task is still running. Recovery is unavailable."
msgstr "任务仍在运行，无法恢复。"

msgid "The thumbnail must be a local image file no larger than 4 MiB."
msgstr "缩略图须为不超过 4 MiB 的本地图片文件。"

msgid "The total expanded ZIP size exceeds 64 MiB."
msgstr "ZIP 解压总大小超过 64 MiB。"

msgid "The upload exceeds the server upload limit. Ask the server administrator to check upload_max_filesize and post_max_size; keep the plugin file-size limits."
msgstr "上传超过服务器限制。请让服务器管理员检查 upload_max_filesize 与 post_max_size；仍须遵守插件的文件大小限制。"

msgid "The upload was interrupted. Check your connection and upload the complete file again."
msgstr "上传已中断。请检查网络连接，并重新上传完整文件。"

msgid "The uploaded file is invalid."
msgstr "上传文件无效。"

msgid "The uploaded file or update request is invalid."
msgstr "上传文件或更新请求无效。"

msgid "The uploads directory is unavailable."
msgstr "上传目录不可用。"

msgid "The welcome motion reference is invalid."
msgstr "欢迎动作引用无效。"

msgid "This browser does not support WebGL; the mascot cannot be displayed."
msgstr "浏览器不支持 WebGL，无法显示看板娘"

msgid "This character ID already exists. Use a new ID; the existing character will not be overwritten."
msgstr "角色 ID 已存在，请使用新的 ID；现有角色不会被覆盖。"

msgid "This character requires WebGL 2. Choose another character or browser."
msgstr "此角色需要 WebGL 2，请选择其他角色或更换浏览器"

msgid "This entry check does not render models. Mobile remains off by default; reduced motion and account display preferences still apply."
msgstr "此入口检查不渲染模型。移动端仍默认关闭；减少动画与账号显示偏好仍然有效。"

msgid "Thumbnail commit failed."
msgstr "缩略图提交失败。"

msgid "Thumbnail encoding failed."
msgstr "缩略图编码失败。"

msgid "Thumbnail import requires PHP GD."
msgstr "缩略图导入需要 PHP GD。"

msgid "Thumbnail of %1$s"
msgstr "%1$s 的缩略图"

msgid "Thumbnail operation is invalid."
msgstr "缩略图操作无效。"

msgid "Thumbnail reference cleared; the original file is retained."
msgstr "缩略图引用已清除，原文件保留。"

msgid "Thumbnail upload failed."
msgstr "缩略图上传失败。"

