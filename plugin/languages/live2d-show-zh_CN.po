msgstr "预设需要名称，并至少包含动作、表情或台词中的一项。"

msgid "A preset resource cannot be mapped. Repair the preset before exporting."
msgstr "无法映射快捷互动资源，请先修复该快捷互动再导出。"

msgid "A recovery record is unreadable or invalid. Preserve it for server inspection."
msgstr "有恢复记录无法读取或校验未通过，请保留并由服务器管理员检查。"

msgid "A resource or settings task is in progress. Inspect task status before retrying."
msgstr "资源或设置任务正在进行。请先检查任务状态，再重试。"

msgid "A resource or settings task is in progress. Wait for it to finish, then refresh."
msgstr "资源或设置任务正在进行，请等待完成后刷新。"

msgid "A resource task is in progress or configuration changed during inventory; classification is unknown."
msgstr "资源任务正在进行，或盘点期间配置发生变化；引用分类未知。"

msgid "A short pause may help the next paragraph."
msgstr "稍作休息，下一段也许更容易理解。"

msgid "A sip of water and we are ready again."
msgstr "喝口水，再继续吧。"

msgid "A small pause can make room for a new thought."
msgstr "稍作停留，也许会有新的想法。"

msgid "A small question can lead to an interesting discovery."
msgstr "一个小问题，也可能带来很有趣的发现。"

msgid "A template resource is missing or ambiguous in this character. Import dialogue only, or fix the matching catalog."
msgstr "此角色中缺少模板所需资源，或同一路径对应多个资源。请仅导入台词，或先修复资源目录的映射。"

msgid "Accept terms and enable mobile animation in this browser"
msgstr "同意条款并在本浏览器开启移动动画"

msgid "Accept terms and show"
msgstr "同意条款并显示"

msgid "Account and browser differ. Choose which preferences to use; saving to the account is a separate action."
msgstr "账号与本机偏好不同，请明确选择使用哪一份；保存到账号需另行操作。"

msgid "Account and browser preferences match."
msgstr "账号与本机偏好一致。"

msgid "Account preferences"
msgstr "账号偏好"

msgid "Account preferences applied to this browser."
msgstr "已将账号偏好应用到此浏览器。"

msgid "Account preferences are busy. Try again."
msgstr "账号偏好正忙，请重试。"

msgid "Account preferences could not be read or saved. Your browser preferences are retained."
msgstr "无法读取或保存账号偏好，本机偏好已保留。"

msgid "Account preferences saved in this browser. The selected character is unavailable now; the current display is retained."
msgstr "账号偏好已保存在此浏览器，所选角色暂时不可用，保留当前显示。"

msgid "Account preferences saved. Any later browser changes remain local."
msgstr "账号偏好已保存，之后的本机变更仍仅保存在本机。"

msgid "Action completed"
msgstr "操作已完成"

msgid "Active"
msgstr "启用"

